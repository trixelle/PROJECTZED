<style>
.rdx{padding:0;}
.rd-wrap{max-width:680px;margin:0 auto;padding:0 22px;}

/* chapter header  */
.rd-head{padding:54px 0 30px;border-bottom:1px solid rgba(77,88,102,.34);margin-bottom:38px;}
.rd-meta{display:flex;flex-wrap:wrap;gap:8px 20px;font-family:var(--tx-mono,monospace);
  font-size:10px;letter-spacing:.2em;color:var(--tx-grid,#4d5866);margin-bottom:16px;}
.rd-meta span:nth-child(2){color:var(--tx-signal,#ff2f43);}
.rd-title{font-family:var(--tx-disp,sans-serif);font-weight:700;
  font-size:clamp(34px,6vw,58px);line-height:1.02;letter-spacing:-.015em;
  color:var(--tx-bone,#e6e4de);margin:0;}

/* body prose  */
.rdx p{font-family:var(--tx-body,'IBM Plex Sans',system-ui,sans-serif);
  font-size:17px;line-height:1.78;color:#c6ccd3;margin:0 0 1.25em;
  text-wrap:pretty;}
.rdx p+p{text-indent:0;}

/* mission reports, notices, case files */
.rd-file{font-family:var(--tx-mono,monospace);font-size:12px;line-height:2;
  letter-spacing:.07em;color:#9aa2ac;background:rgba(15,17,20,.75);
  padding:18px 20px;margin:0 0 1.6em;position:relative;}
.rd-file::before,.rd-file::after{content:'';position:absolute;width:11px;height:11px;
  border:1px solid var(--tx-signal,#ff2f43);opacity:.8;}
.rd-file::before{top:0;left:0;border-right:0;border-bottom:0;}
.rd-file::after{bottom:0;right:0;border-left:0;border-top:0;}

/*  HUD telemetry */
.rd-hud{font-family:var(--tx-mono,monospace)!important;font-size:12.5px!important;
  line-height:1.85!important;letter-spacing:.06em;color:#8f97a1!important;
  margin:0 0 .4em!important;padding-left:2px;}
.rd-hud+.rd-hud{margin-top:-.4em!important;}
.rd-hud+p,.rd-trx+p{margin-top:1.5em;}

/* TRIXE  */
.rd-trx{font-family:var(--tx-mono,monospace)!important;font-size:13.5px!important;
  line-height:1.7!important;color:var(--tx-trixe,#ffc46b)!important;
  border-left:2px solid var(--tx-trixe,#ffc46b);padding-left:13px;
  margin:1.3em 0!important;text-shadow:0 0 16px rgba(255,196,107,.3);}

/*  doctrine billboards */
.rd-doc{font-family:var(--tx-disp,sans-serif);font-weight:700;
  font-size:clamp(17px,2.6vw,23px);line-height:1.55;letter-spacing:.12em;
  color:var(--tx-bone,#e6e4de);margin:1.7em 0;padding-left:18px;
  border-left:3px solid var(--tx-signal,#ff2f43);}

/* vendor strings and stamps*/
.rd-stamp{font-family:var(--tx-mono,monospace)!important;font-size:13px!important;
  letter-spacing:.18em;color:var(--tx-bone,#e6e4de)!important;
  margin:1.5em 0!important;padding:9px 14px;display:inline-block;
  border:1px solid rgba(77,88,102,.6);background:rgba(15,17,20,.7);}


.rdx[data-part]:not([data-part="1"]) .rd-head{display:none;}

@media(max-width:640px){
  .rdx p{font-size:16px;}
  .rd-head{padding:38px 0 24px;margin-bottom:28px;}
  .rd-file{font-size:11px;padding:14px 15px;}
}
</style>