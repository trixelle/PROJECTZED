<style>
/* spacer: this is the only part that sits in Carrd's flow.
It exists purely to give the zoom something to scroll through. */
.tx-zoom{height:340vh;position:relative;margin-top:26px;}

/* the stage is moved to <body> by E2 and pinned to the viewport */
#tx-stage{position:fixed;inset:0;z-index:3;pointer-events:none;
opacity:0;visibility:hidden;transition:opacity .25s linear;}
#tx-stage.on{opacity:1;visibility:visible;}
#tx-stage .inner{height:100%;max-width:1180px;margin:0 auto;padding:0 22px;
display:grid;grid-template-columns:300px minmax(0,1fr);gap:28px;align-items:center;}

.tx-cap .depth{font-size:10px;letter-spacing:.2em;color:var(--tx-grid);margin-bottom:10px;}
.tx-cap h3{font-family:var(--tx-disp);font-weight:600;font-size:clamp(21px,2.6vw,30px);
margin:0 0 10px;color:var(--tx-bone);}
.tx-cap p{font-size:13.5px;line-height:1.8;color:#a9b0b9;margin:0;max-width:38ch;}
.tx-cap.amb h3,.tx-cap.amb p{color:var(--tx-trixe);}
.tx-cap .swap{transition:opacity .2s linear;}
.tx-mag{margin-top:22px;font-size:10.5px;letter-spacing:.14em;color:var(--tx-grid);}
.tx-mag b{color:var(--tx-bone);font-weight:500;}
.tx-mag .track{height:2px;background:rgba(77,88,102,.3);margin-top:7px;position:relative;}
.tx-mag .track i{position:absolute;left:0;top:0;bottom:0;background:var(--tx-bone);width:0;}

.tx-svgwrap{position:relative;height:100%;display:flex;align-items:center;justify-content:center;}
.tx-svgwrap svg{width:100%;height:100%;max-height:86vh;}
#tx-zg *{vector-effect:non-scaling-stroke;}
.zl{transition:opacity .12s linear;}
.tx-pulse{animation:tx-pl 2.6s ease-in-out infinite;transform-origin:center;}
@keyframes tx-pl{0%,100%{opacity:.55;}50%{opacity:1;}}

.tx-focus{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
width:120px;height:120px;pointer-events:none;}
.tx-focus i{position:absolute;inset:0;}
.tx-focus i::before,.tx-focus i::after{content:'';position:absolute;background:rgba(230,228,222,.28);}
.tx-focus i::before{left:50%;top:44px;bottom:44px;width:1px;}
.tx-focus i::after{top:50%;left:44px;right:44px;height:1px;}
.tx-focus b{position:absolute;left:68px;top:32px;font-size:9.5px;letter-spacing:.16em;
font-weight:400;color:var(--tx-grid);white-space:nowrap;}
.tx-focus.amb i::before,.tx-focus.amb i::after{background:rgba(255,196,107,.5);}
.tx-focus.amb b{color:var(--tx-trixe);}

.tx-dossiers{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:34px;}
.tx-dos h3{font-family:var(--tx-disp);font-weight:600;font-size:22px;margin:0 0 3px;color:var(--tx-bone);}
.tx-dos .sub{font-size:10.5px;letter-spacing:.16em;color:var(--tx-grid);margin-bottom:18px;}
.tx-dos dl{display:grid;grid-template-columns:132px 1fr;gap:9px 14px;margin:0;font-size:12.5px;}
.tx-dos dt{color:var(--tx-grid);font-size:10.5px;letter-spacing:.09em;padding-top:2px;}
.tx-dos dd{margin:0;color:var(--tx-bone);line-height:1.5;}
.tx-dos.trixe h3{color:var(--tx-trixe);}
.tx-dos.trixe::before,.tx-dos.trixe::after{border-color:var(--tx-trixe);opacity:.6;}
.tx-dos .note{margin:18px 0 0;font-size:12.5px;line-height:1.75;color:#98a0aa;}

@media(max-width:860px){
.tx-zoom{height:280vh;}
#tx-stage .inner{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);
gap:12px;align-content:center;padding:60px 18px;}
.tx-cap p{max-width:none;}
.tx-dossiers{grid-template-columns:1fr;}
}
@media(prefers-reduced-motion:reduce){ .tx-pulse{animation:none;} }
</style>

