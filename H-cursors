<style>
/* ---- normal select ---- */
html, body, .tx-embed, .tx-embed * {
cursor: url("data:image/png;base64,") 4 2, auto;
}

/* ---- link select : anything clickable ---- */
a, button, summary, label,
#tx-nav a, .op summary, .tx-tabs button, #tx-gauge .node, .rd,
form .button, form input[type="submit"], form button[type="submit"] {
cursor: url("data:image/png;base64,") 10 2, pointer;
}

/* ---- text select : fields, and the prose worth reading ---- */
input[type="text"], input[type="email"], input[type="tel"], textarea, [contenteditable],
.tx-doc p, .tx-doc li, .op .body p, .tx-cap p, .tx-dos .note, .tx-hero .thesis {
